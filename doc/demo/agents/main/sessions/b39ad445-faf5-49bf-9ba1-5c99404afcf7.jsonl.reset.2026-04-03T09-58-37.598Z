**\n🍞 包含：香葱肉松卷、手撕面包、水牛乳整箱等\n\n---\n\n这2条都是**近1-2天内的**，有链接！点进去能看具体价格。主人看看有没有需要的～🐑"}],"api":"anthropic-messages","provider":"MiniMax","model":"MiniMax-M2.7","usage":{"input":63789,"output":731,"cacheRead":17545,"cacheWrite":0,"totalTokens":82065,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"stop","timestamp":1775209981535,"responseId":"061ec1005042b7aa3a929b4a0860bc61"}}
